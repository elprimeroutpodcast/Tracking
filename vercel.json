{
  "rewrites": [
    { "source": "/mk/:token", "destination": "/api/mk/:token" },
    { "source": "/open/:token", "destination": "/api/open/:token" }
  ],
  "headers": [
    {
      "source": "/open/:token",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}